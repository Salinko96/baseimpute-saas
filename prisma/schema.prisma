generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  password       String
  role           Role         @default(DECLARANT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum Role {
  ADMIN
  DECLARANT
  CLIENT
}

model Client {
  id           String         @id @default(cuid())
  name         String
  nif          String         @unique
  agreementNo  String?
  address      String?
  email        String?
  phone        String?
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  shBases      ClientSHBase[]
  folders      ImportFolder[]
  exemptions   ExemptionRule[]
}

model ClientSHBase {
  id        String @id @default(cuid())
  client    Client @relation(fields: [clientId], references: [id])
  clientId  String
  shCode    String // Code SH propre au client
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, shCode])
}

model ImportFolder {
  id          String       @id @default(cuid())
  client      Client       @relation(fields: [clientId], references: [id])
  clientId    String
  folderNumber String       @unique
  status      FolderStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lines       FolderLine[]
}

enum FolderStatus {
  DRAFT
  VALIDATED
  SUBMITTED
  COMPLETED
}

model FolderLine {
  id             String       @id @default(cuid())
  folder         ImportFolder @relation(fields: [folderId], references: [id])
  folderId       String
  description    String
  shCode         String       // Code SH matché avec le TEC
  cifValue       Float
  dutyAmount     Float        @default(0)
  statAmount     Float        @default(0)
  otherTaxes     Float        @default(0)
  totalAmount    Float        @default(0)
  isExempt       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TECVersion {
  id          String    @id @default(cuid())
  versionName String    // ex: "Tarif 2017"
  sourceFile  String
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(false)
  rates       TECRate[]
}

model TECRate {
  id           String     @id @default(cuid())
  tecVersion   TECVersion @relation(fields: [tecVersionId], references: [id])
  tecVersionId String
  position     String     // N° de position (ex: 01.01)
  nts          String     // Code SH complet (ex: 0101.21.00.00)
  description  String
  unit         String?     // U.S.
  dutyRate     Float      // D.D.
  statRate     Float      // R.S.
  otherRate    Float      @default(0) // P.C.I. etc.
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tecVersionId, nts])
}

model ExemptionRule {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  ruleCode    String
  description String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entityId  String
  entityType String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}
